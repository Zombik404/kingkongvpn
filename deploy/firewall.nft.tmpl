#!/usr/sbin/nft -f
# globalvpn firewall — only our own table; Docker's rules are left alone (no `flush ruleset`).
# Rendered by install.sh: @WAN@ = public interface, @V6_POLICY@ = accept-or-reject line.
table inet globalvpn
delete table inet globalvpn

table inet globalvpn {
	set private4 {
		type ipv4_addr; flags interval
		elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16,
			     172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/3 }
	}
	set private6 {
		type ipv6_addr; flags interval
		elements = { ::1/128, fc00::/7, fe80::/10, ff00::/8 }
	}

	chain input {
		type filter hook input priority filter; policy accept;
		# VPN clients may reach this host only for ping and the website/Mini App (HTTPS).
		iifname "wg0" ct state established,related accept
		iifname "wg0" meta l4proto { icmp, ipv6-icmp } accept
		iifname "wg0" tcp dport { 80, 443 } accept
		iifname "wg0" udp dport 443 accept
		iifname "wg0" counter drop
	}

	chain forward {
		type filter hook forward priority filter; policy accept;
		iifname "wg0" oifname "wg0" counter drop comment "no client-to-client traffic"
		iifname "wg0" ct status dnat accept comment "the site on this host (Docker-published ports)"
		iifname "wg0" ip daddr @private4 counter drop comment "no LAN / metadata / provider networks"
		iifname "wg0" ip6 daddr @private6 counter drop
		iifname "wg0" tcp dport { 25, 465, 587 } counter reject with tcp reset comment "anti-spam"
		@V6_POLICY@
		iifname "wg0" oifname "@WAN@" accept
		oifname "wg0" ct state established,related accept comment "replies (internet and this site)"
		oifname "wg0" counter drop comment "nothing else may initiate into the tunnel"
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		iifname "wg0" oifname "@WAN@" masquerade
	}
}
