# =============================================================================
# global-vpn — environment template
# Copy to `.env` for local development:  cp .env.example .env
# PLACEHOLDERS ONLY. Never commit a real `.env`. Production secrets live in the
# deployment secret store, not in files in this repository.
# =============================================================================

# --- General -----------------------------------------------------------------
APP_ENV=development                 # development | testing | staging | production
APP_NAME=GlobalVPN                  # brand name placeholder
LOG_LEVEL=INFO
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
ADMIN_WEB_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=globalvpn
POSTGRES_USER=globalvpn
POSTGRES_PASSWORD=change-me-dev-only
# Assembled by the app if unset:
# DATABASE_URL=postgresql+asyncpg://globalvpn:change-me-dev-only@postgres:5432/globalvpn

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Auth / tokens -----------------------------------------------------------
# Generate with: make keys   (writes to ./secrets/, which is git-ignored)
JWT_PRIVATE_KEY_FILE=/run/secrets/jwt_ed25519_private.pem
JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_ed25519_public.pem
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_PEPPER=replace-with-64-random-hex-chars
PASSWORD_MIN_LENGTH=10
# AES-256-GCM key for secrets at rest (TOTP seeds). base64 of 32 random bytes:
#   python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Required outside development. Losing it means admins must re-enrol 2FA.
DATA_ENCRYPTION_KEY=
ADMIN_REQUIRE_MFA=true

# --- Email (dev uses mailpit at http://localhost:8025) -----------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.invalid
SMTP_STARTTLS=false
EMAIL_DELIVERY=celery              # celery (queue, retries) | sync (inline SMTP)

# --- VPN control plane -------------------------------------------------------
VPN_TUNNEL_IPV4_POOL=10.64.0.0/10
VPN_TUNNEL_IPV6_POOL=fd00:6476:706e::/48
VPN_TUNNEL_RESERVED_ADDRESSES=16    # first N pool addresses are for node interfaces
NODE_CA_CERT_FILE=/run/secrets/node_ca.crt
NODE_CA_KEY_FILE=/run/secrets/node_ca.key
NODE_HEARTBEAT_STALE_SECONDS=90
PEER_IDLE_TTL_HOURS=24

# --- Telegram (optional channel) ---------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
BOT_SERVICE_CLIENT_ID=telegram-bot
BOT_SERVICE_CLIENT_SECRET=
TELEGRAM_BOT_USERNAME=              # without @; "Return to bot" button after payment

# --- Crypto payments: Crypto Pay API (@CryptoBot) ------------------------------
# Token: @CryptoTestnetBot (testnet) or @CryptoBot (mainnet) → Crypto Pay → Create App.
# Webhook URL to set there: https://<your-domain>/api/v1/webhooks/cryptobot
# Without a webhook the backend still confirms payments by polling every 60 s.
CRYPTOBOT_API_TOKEN=
CRYPTOBOT_NETWORK=testnet           # testnet | mainnet (mainnet required in production)
# Check the exact asset code with: python -m app.cli cryptobot-check  (TON → GRAM rebrand)
CRYPTOBOT_ACCEPTED_ASSETS=GRAM
CRYPTOBOT_INVOICE_TTL_SECONDS=3600

# --- Payments (leave empty until Phase 10; test-mode keys only outside prod) --
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_FILE=
APPLE_BUNDLE_ID=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=

# --- Infrastructure automation (never auto-spend without these set) ----------
AUTOSCALE_ENABLED=false
AUTOSCALE_MONTHLY_SPEND_LIMIT_EUR=0
HCLOUD_TOKEN=

# --- Observability -----------------------------------------------------------
SENTRY_DSN=
PROMETHEUS_METRICS_ENABLED=true
